{
  "name": "lexitrace",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "description": "LexiTrace 詞跡 - lightweight contextual vocabulary lookup and passive review browser extension.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sheng1111/lexitrace.git"
  },
  "bugs": {
    "url": "https://github.com/sheng1111/lexitrace/issues"
  },
  "homepage": "https://github.com/sheng1111/lexitrace#readme",
  "type": "module",
  "scripts": {
    "dev": "npm run build",
    "build:icons": "node scripts/generate-icons.mjs",
    "build": "npm run build:icons && npm run build:manifest && npm run build:pages && npm run build:content && npm run build:background",
    "build:release": "LEXITRACE_RELEASE=true npm run build",
    "build:manifest": "node scripts/build-manifest.mjs",
    "build:pages": "vite build --config vite.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build:background": "vite build --config vite.background.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "opencc-js": "^1.3.0",
    "wink-lemmatizer": "^3.0.4"
  }
}
